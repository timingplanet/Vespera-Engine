<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(VesperaTargetFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(VesperaTargetFramework)' != ''">$(VesperaTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VesperaPerformanceLab.Scripts</AssemblyName>
    <RootNamespace>VesperaPerformanceLab</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VesperaSdkProject)" Condition="'$(VesperaSdkProject)' != ''" />
  </ItemGroup>
  <Target Name="ValidateVesperaSdkProject" BeforeTargets="ResolveReferences">
    <Error Condition="'$(VesperaSdkProject)' == ''" Text="VesperaSdkProject was not supplied. Build this sample through Vespera." />
    <Error Condition="'$(VesperaSdkProject)' != '' and !Exists('$(VesperaSdkProject)')" Text="Vespera.NET project was not found at '$(VesperaSdkProject)'." />
  </Target>
</Project>

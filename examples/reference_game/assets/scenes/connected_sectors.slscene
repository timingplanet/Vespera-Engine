sectorline_scene 14
# Vespera Engine 0.5.0 reference world (scene format v10; point lights + C# managed scripting).
# Textures are asset references by name and are registered by the reference game
# until the real asset importer/resource database lands.

camera 0 1.65 -4 0 0 75 0.05 500

material "Entry Floor" 0.48 0.56 0.68 1.0 "Floor Tiles" 0.55 0.55
material "Corridor Floor" 0.46 0.68 0.57 1.0 "Metal Panels" 0.60 0.60
material "Raised Floor" 0.72 0.54 0.36 1.0 "Chamber Tiles" 0.55 0.55
material "Dark Ceiling" 0.34 0.38 0.48 1.0 "Ceiling Tiles" 0.50 0.50
material "High Ceiling" 0.44 0.35 0.47 1.0 "Ceiling Tiles" 0.50 0.50
material "Concrete" 0.58 0.66 0.76 1.0 "Concrete Brick" 0.45 0.45
material "Portal Blue" 0.24 0.82 1.00 1.0 "Metal Panels" 0.75 0.75
material "Portal Warm" 1.00 0.58 0.25 1.0 "Metal Panels" 0.75 0.75
material "Chamber Wall" 0.73 0.50 0.70 1.0 "Concrete Brick" 0.45 0.45

sprite_clip "Watcher Walk" 8 2 4.0 1 "Watcher D0 F0" "Watcher D0 F1" "Watcher D1 F0" "Watcher D1 F1" "Watcher D2 F0" "Watcher D2 F1" "Watcher D3 F0" "Watcher D3 F1" "Watcher D4 F0" "Watcher D4 F1" "Watcher D5 F0" "Watcher D5 F1" "Watcher D6 F0" "Watcher D6 F1" "Watcher D7 F0" "Watcher D7 F1"

sector "Entry Hall" 0.0 3.6 "Entry Floor" "Dark Ceiling" "Concrete"
  vertex -4 -6
  vertex 4 -6
  vertex 4 0
  vertex 2 0
  vertex -2 0
  vertex -4 0
  side "Concrete" -1
  side "Concrete" -1
  side "Concrete" -1
  side "Portal Blue" 1
  side "Concrete" -1
  side "Concrete" -1
endsector

sector "Step Corridor" 0.30 2.80 "Corridor Floor" "Dark Ceiling" "Concrete"
  vertex -2 0
  vertex 2 0
  vertex 2 5
  vertex -2 5
  side "Portal Blue" 0
  side "Concrete" -1
  side "Portal Warm" 2
  side "Concrete" -1
endsector

sector "Raised Chamber" 0.60 4.20 "Raised Floor" "High Ceiling" "Chamber Wall"
  vertex -4 5
  vertex -2 5
  vertex 2 5
  vertex 4 5
  vertex 4 11
  vertex -4 11
  side "Chamber Wall" -1
  side "Portal Warm" 1
  side "Chamber Wall" -1
  side "Chamber Wall" -1
  side "Chamber Wall" -1
  side "Chamber Wall" -1
endsector

# Scene-v11 entities own native components plus ordered managed script attachments.
entity 1001 1 "Corridor Watcher"
  identity "enemy" "Actors"
  transform 0 0.30 2.55 0 0.0 0 1 1 1
  sprite_renderer 1.30 1.75 "Test Sprite" "Watcher Walk" 1.0 0.0 0 0.92 1.00 0.96 1.0
  managed_script "ReferenceGame.Scripts.ManagedSpinner" 1
    managed_field "SpinSpeed" "float" "0.65"
    managed_field "Direction" "enum" "Clockwise"
  end_managed_script
endentity

entity 1002 1 "Chamber Watcher"
  identity "enemy" "Actors"
  prefab_source_asset "3ea2605121c0ad8e0875f49b7b5c334c" "prefabs/watcher.slprefab"
  transform 1.7 0.60 8.30 0 3.14159265 0 1 1 1
  sprite_renderer 1.65 2.10 "Test Sprite" "Watcher Walk" 0.75 0.18 0 1.00 0.76 0.88 1.0
  cylinder_collider 0.48 2.10 0 1.05 0 0
endentity

# A transform-only entity proves entities are not synonymous with sprites.
entity 1003 1 "Gameplay Marker"
  identity "marker" "Gameplay"
  transform 0 0.30 4.25 0 0 0 1 1 1
  managed_script "ReferenceGame.Scripts.GameplayShowcase" 1
  end_managed_script
endentity

# Invisible trigger volume used to prove the public trigger enter/exit tracker.
entity 1004 1 "Chamber Threshold"
  identity "checkpoint" "Triggers"
  transform 0 0.60 6.25 0 0 0 1 1 1
  cylinder_collider 1.15 2.40 0 1.20 0 1
  managed_script "ReferenceGame.Scripts.TriggerReporter" 1
  end_managed_script
endentity

# Real-time lighting reference. The current renderer evaluates the two closest
# enabled point lights to the active camera with radial attenuation.
entity 1005 1 "Corridor Amber Light"
  identity "light" "Lighting"
  transform -0.8 2.05 2.20 0 0 0 1 1 1
  point_light 1.00 0.48 0.18 1.0 1.55 5.25
endentity

entity 1006 1 "Chamber Cyan Light"
  identity "light" "Lighting"
  transform 1.2 2.65 8.25 0 0 0 1 1 1
  point_light 0.16 0.72 1.00 1.0 1.35 6.25
endentity

end
